{
  "name": "daywork",
  "version": "0.1.0",
  "description": "Ontario local-work marketplace with milestone payments on Cloudflare Workers and Stripe Connect",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev --env local --port 8787",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db:local": "wrangler d1 migrations apply DB --local --env local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "cf:types": "wrangler types --strict-vars=false",
    "deploy:check": "npm run build && wrangler deploy --dry-run",
    "check": "npm run typecheck && npm test && npm run build",
    "deploy": "npm run check && npm run db:remote && wrangler deploy"
  },
  "keywords": [],
  "type": "module",
  "dependencies": {
    "hono": "^4.13.16",
    "lucide-react": "^1.67.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "stripe": "^23.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/workers-types": "^5.20261104.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "wrangler": "^4.157.0"
  },
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/defcron/daywork.git"
  }
}
